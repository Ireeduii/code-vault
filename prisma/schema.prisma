generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Snippet {
  id          String   @id @default(cuid())
  title       String
  description String?
  code        String
  language    String
  tags        String[]
  isFavorite  Boolean  @default(false)
  userId      String?  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

